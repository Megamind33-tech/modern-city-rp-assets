[remap]

importer="scene"
importer_version=1
type="PackedScene"

[params]
gltf/embedded_image_handling=0
meshes/ensure_tangents=false
_subresources={
"materials": {
"palette": {
"use_external/enabled": true,
"use_external/path": "res://assets/materials/palette.tres"
},
"palette_emissive": {
"use_external/enabled": true,
"use_external/path": "res://assets/materials/palette_emissive.tres"
}
}
}
